# ═══════════════════════════════════════════════════════════════════════
#  SKY — environment template
#  Copy to .env, fill in, then:  chmod 600 .env
#
#  ⚠️  TIER 0 BOUNDARY
#  Everything marked [T0] is a secret. It is never committed, never logged,
#  and never placed in an LLM context window. Tools broker access to these
#  values; the model receives results, not credentials.
# ═══════════════════════════════════════════════════════════════════════

# ─── Identity ──────────────────────────────────────────────────────────
# Ruled in DL-001: the identity is Sky Prime, embodied. "Sky" is the
# conversational address and the eventual wake word — not a second entity.
SKY_IDENTITY_NAME=Sky Prime
SKY_ADDRESS_NAME=Sky
SKY_ENV=production
SKY_VERSION=0.1.0-phase0

# ─── Gateway ───────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
# Comma-separated origins allowed to open a WebSocket. Tighten in Phase 1.
GATEWAY_ALLOWED_ORIGINS=https://sky.example.com
LOG_LEVEL=INFO

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=sky
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM          # [T0]
POSTGRES_DB=sky
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── LLM providers  (needed Phase 1) ───────────────────────────────────
ANTHROPIC_API_KEY=                                # [T0]
OPENAI_API_KEY=                                   # [T0]
SKY_PRIMARY_MODEL=claude-opus-5
SKY_FAST_MODEL=claude-sonnet-5

# ─── Cost guardrails  (Risk #9 — cost drift) ───────────────────────────
# Hard ceiling. Gateway refuses new LLM calls past this. Alert fires at 75%.
SKY_MONTHLY_COST_CAP_USD=50
SKY_COST_ALERT_THRESHOLD=0.75

# ─── Backups  (task 0.6) ───────────────────────────────────────────────
# restic. The password is the ONLY thing standing between an offsite
# snapshot and a stranger. Store a copy somewhere that is not this machine.
RESTIC_REPOSITORY_LOCAL=/srv/sky-backup/local
RESTIC_REPOSITORY_REMOTE=                         # e.g. b2:bucket:sky  or  s3:...
RESTIC_PASSWORD=                                  # [T0]
B2_ACCOUNT_ID=                                    # [T0]
B2_ACCOUNT_KEY=                                   # [T0]
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# ─── Actions  (needed Phase 2 — leave blank for now) ───────────────────
GOOGLE_CLIENT_ID=                                 # [T0]
GOOGLE_CLIENT_SECRET=                             # [T0]
GOOGLE_REFRESH_TOKEN=                             # [T0]
ACTIVEPIECES_API_URL=http://127.0.0.1:18081
ACTIVEPIECES_API_KEY=                             # [T0]
